rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeRole(role) {
      return signedIn() && profile().active != false && profile().role == role;
    }

    function manager() {
      return activeRole('Manager');
    }

    function designer() {
      return activeRole('Designer');
    }

    function managerOrDesigner() {
      return manager() || designer();
    }

    function assignedProjectMember() {
      return signedIn() && profile().active != false
        && ((resource.data.activeAssignees is list
              && (request.auth.uid in resource.data.activeAssignees
                || (('legacyProfileIds' in profile()) && profile().legacyProfileIds is list && resource.data.activeAssignees.hasAny(profile().legacyProfileIds))))
          || (('assignedSetterId' in resource.data)
              && (request.auth.uid == resource.data.assignedSetterId
                || (('legacyProfileIds' in profile()) && profile().legacyProfileIds is list && resource.data.assignedSetterId in profile().legacyProfileIds)))
          || (('assignedJewellerId' in resource.data)
              && (request.auth.uid == resource.data.assignedJewellerId
                || (('legacyProfileIds' in profile()) && profile().legacyProfileIds is list && resource.data.assignedJewellerId in profile().legacyProfileIds)))
          || (('assignedDesignerId' in resource.data)
              && (request.auth.uid == resource.data.assignedDesignerId
                || (('legacyProfileIds' in profile()) && profile().legacyProfileIds is list && resource.data.assignedDesignerId in profile().legacyProfileIds)))
          || (('createdById' in resource.data)
              && (request.auth.uid == resource.data.createdById
                || (('legacyProfileIds' in profile()) && profile().legacyProfileIds is list && resource.data.createdById in profile().legacyProfileIds))));
    }

    function assignedDesigner() {
      return designer() && assignedProjectMember();
    }

    function assignedProductionStaff() {
      return assignedProjectMember()
        && (profile().role == 'Setter' || profile().role == 'Jeweller');
    }

    function pickedUp() {
      return (('status' in resource.data) && resource.data.status == 'Closed')
        || (('date_picked_up' in resource.data) && resource.data.date_picked_up != null);
    }

    function nonRepairPickupUnchanged() {
      return (('repair' in resource.data) && resource.data.repair is map)
        || ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['date_picked_up']))
          && (!('status' in request.resource.data)
            || request.resource.data.status != 'Closed'
            || (('status' in resource.data) && resource.data.status == 'Closed')));
    }

    function validProjectServiceOnCreate() {
      return request.resource.data.services is list
        && request.resource.data.services.size() == 1
        && request.resource.data.services[0] is map
        && request.resource.data.services[0].keys().hasOnly(['code', 'status', 'updatedAt', 'updatedBy'])
        && request.resource.data.services[0].code in ['CUSTOM_MAKE', 'ENGAGEMENT', 'REPAIR']
        && request.resource.data.services[0].status in ['PENDING', 'IN_PROGRESS', 'COMPLETED'];
    }

    function projectServiceIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['services'])
        || (resource.data.services is list
          && request.resource.data.services is list
          && resource.data.services.size() == 1
          && request.resource.data.services.size() == 1
          && resource.data.services[0] is map
          && request.resource.data.services[0] is map
          && (('code' in resource.data.services[0])
            && request.resource.data.services[0].code == resource.data.services[0].code)
          && request.resource.data.services[0].diff(resource.data.services[0]).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'updatedBy']));
    }

    function directProjectUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'workDetails', 'goldType', 'goldPurity', 'instructionRevisionVersion',
          'metalRevisionVersion', 'projectRevisionUpdatedAt', 'goldComponents', 'primaryGoldComponentId',
          'pickupPricingSnapshot', 'projectEndGoldPriceSnapshot',
          'projectEndGoldPriceCapturedAt', 'finalGoldCostCalculated', 'serviceMigration'
        ])
        && projectServiceIdentityUnchanged()
        && nonRepairPickupUnchanged()
        && !pickedUp();
    }

    function appendedOnly(oldList, newList) {
      return oldList is list && newList is list
        && newList.size() == oldList.size() + 1
        && newList[0:oldList.size()] == oldList;
    }

    function productionProjectUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'progress', 'currentStageName', 'currentPercentComplete',
          'services', 'designLogs', 'projectPhotos', 'projectPhotoIds',
          'repair', 'status', 'date_completed', 'date_picked_up',
          'last_status_change_at', 'last_status_change_by', 'castingEvents'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progress'])
          || ((!('progress' in resource.data)
                && request.resource.data.progress is list
                && request.resource.data.progress.size() == 1)
            || (('progress' in resource.data)
                && appendedOnly(resource.data.progress, request.resource.data.progress))))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['designLogs'])
          || ((!('designLogs' in resource.data)
                && request.resource.data.designLogs is list
                && request.resource.data.designLogs.size() == 1)
            || (('designLogs' in resource.data)
                && appendedOnly(resource.data.designLogs, request.resource.data.designLogs))))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['repair'])
          || (resource.data.repair is map
            && request.resource.data.repair is map
            && request.resource.data.repair.diff(resource.data.repair).affectedKeys()
              .hasOnly(['status', 'completedDate'])))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'date_completed', 'date_picked_up', 'last_status_change_at', 'last_status_change_by'
          ])
          || request.resource.data.diff(resource.data).affectedKeys().hasAny(['repair']));
    }

    // Canonical security profiles are keyed by Firebase Auth UID. Legacy user
    // documents remain readable for compatibility, but are not authorization roots.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if manager() || (signedIn() && request.auth.uid == userId
        && request.resource.data.authUid == request.auth.uid
        && (request.resource.data.role == 'Setter' || request.resource.data.role == 'Jeweller' || request.resource.data.role == 'Designer'
          || (request.resource.data.role == 'Manager'
            && (request.auth.token.email == 'kilanimedia@gmail.com' || request.auth.token.email == 'harout@kilani.com'))));
      allow update: if manager() || (signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'active', 'authUid', 'legacyProfileIds']));
      allow delete: if manager();

      match /pushTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      // Project creation may contain component scaffolding. Keep creation
      // Manager-only so a Designer cannot inject pre-locked financial fields.
      allow create: if manager() && validProjectServiceOnCreate();
      allow update: if directProjectUpdateIsSafe()
        && (manager() || assignedDesigner()
          || (assignedProductionStaff() && productionProjectUpdateIsSafe()));
      allow delete: if manager() && !pickedUp();

      match /revisions/{revisionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /system_migrations/{migrationId} {
      allow read: if manager();
      allow write: if false;

      match /backups/{projectId} {
        allow read: if manager();
        allow write: if false;
      }
    }

    // Evidence metadata and object paths are Manager-only. Setters submit an
    // immutable Storage object and the trusted backend creates this record.
    match /evidence/{evidenceId} {
      allow read: if manager();
      allow write: if false;
    }

    // Setters receive only their sanitized bag/request context through a callable.
    // All workflow writes are performed atomically by trusted backend functions.
    match /bags/{bagId} {
      allow read: if manager();
      allow write: if false;
    }

    match /requests/{requestId} {
      allow read: if manager();
      allow write: if false;
    }

    match /movements/{movementId} {
      allow read: if managerOrDesigner();
      allow write: if false;
    }

    match /diamond_transactions/{transactionId} {
      allow read: if managerOrDesigner();
      allow write: if false;
    }

    match /inventory_operations/{operationId} {
      allow read: if manager();
      allow write: if false;
    }

    match /bag_number_claims/{claimId} {
      allow read: if manager();
      allow write: if false;
    }

    match /uniqueness_locks/{lockId} {
      allow read: if manager();
      allow write: if false;
    }

    match /weekly_reports/{reportId} {
      allow read: if managerOrDesigner();
      allow create: if managerOrDesigner();
      allow update, delete: if false;
    }

    match /system_logs/{logId} {
      allow read: if managerOrDesigner();
      allow create: if managerOrDesigner()
        && ((('userId' in request.resource.data) && request.resource.data.userId == request.auth.uid)
          || (('createdById' in request.resource.data) && request.resource.data.createdById == request.auth.uid));
      allow update, delete: if false;
    }

    match /specs/{specId} {
      allow read: if managerOrDesigner();
      allow create: if managerOrDesigner()
        && ((!('pcs' in request.resource.data) && !('ct' in request.resource.data))
          || (request.resource.data.pcs == 0 && request.resource.data.ct == 0));
      allow update: if managerOrDesigner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'pcs', 'ct', 'stockVersion', 'stockUpdatedAt', 'lastInventoryOperationId'
        ]);
      allow delete: if false;
    }

    match /bands/{bandId} {
      allow read: if managerOrDesigner();
      allow write: if managerOrDesigner();
    }

    // Phase 1 intentionally keeps large-stone project assignment disabled.
    match /diamonds/{diamondId} {
      allow read: if managerOrDesigner();
      allow create: if manager()
        && !request.resource.data.keys().hasAny(['projectId', 'referenceProjectId', 'assignedProjectId']);
      allow update: if manager()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['projectId', 'referenceProjectId', 'assignedProjectId']);
      allow delete: if manager();
    }

    match /settings/{settingId} {
      allow read: if managerOrDesigner();
      allow write: if manager();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId || manager());
      allow create: if (!('type' in request.resource.data)
          || request.resource.data.type != 'PROJECT_REVISION')
        && (manager() || (designer()
          && (!('createdById' in request.resource.data)
            || request.resource.data.createdById == request.auth.uid)));
      allow update: if manager() || (signedIn() && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'isRead', 'readAt', 'archived', 'isArchived', 'archivedAt']));
      allow delete: if false;
    }

    match /project_workflow_operations/{operationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
