rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ----------------------------------------------------------------
    // helper functions
    // ----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // ----------------------------------------------------------------
    // evidence/ prefix
    //   Path: evidence/projects/{projectId}/{type}/{filename}
    //   - Any authenticated user may READ (setters need to view thumbnails).
    //   - Any authenticated user may WRITE (upload evidence during their
    //     session). File size is capped to 10MB to prevent DoS.
    // ----------------------------------------------------------------
    match /evidence/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // ----------------------------------------------------------------
    // profiles/ prefix — user avatar uploads
    //   Any signed-in user may read any profile photo.
    //   Writes are restricted to the authenticated user's own path.
    //   Avatar size is capped to 5MB.
    // ----------------------------------------------------------------
    match /profiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }

    // ----------------------------------------------------------------
    // projects/ prefix — project images, attachments
    //   Any signed-in user may read.
    //   Writes allowed for authenticated users. Size capped to 15MB.
    // ----------------------------------------------------------------
    match /projects/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if false;
    }

    // ----------------------------------------------------------------
    // Catch-all: READ is open to all authenticated users.
    // WRITE is explicitly denied for any path not matched above.
    // ----------------------------------------------------------------
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

  }
}
