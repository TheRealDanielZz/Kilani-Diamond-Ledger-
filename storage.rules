rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function canWriteProject() {
      return signedIn();
    }

    function validEvidence(kind, uploaderUid, operationId) {
      return signedIn()
        && resource == null
        && request.auth.uid == uploaderUid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.uploaderUid == uploaderUid
        && request.resource.metadata.operationId == operationId
        && request.resource.metadata.evidenceKind == kind
        && request.resource.metadata.projectId is string;
    }

    match /evidence/issues/{uploaderUid}/{operationId}/{fileName} {
      allow read: if signedIn();
      allow create: if validEvidence('issues', uploaderUid, operationId);
      allow update, delete: if false;
    }

    match /evidence/returns/{uploaderUid}/{operationId}/{fileName} {
      allow read: if signedIn();
      allow create: if validEvidence('returns', uploaderUid, operationId);
      allow update, delete: if false;
    }

    // Historical evidence remains preserved.
    match /evidence/{legacyPath=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /profiles/{userId}/{path=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId}/{path=**} {
      allow read: if signedIn();
      allow create, update: if canWriteProject()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canWriteProject();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
