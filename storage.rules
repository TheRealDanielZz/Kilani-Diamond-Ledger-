rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ----------------------------------------------------------------
    // evidence/ prefix
    //   Files at evidence/{projectId}/{bagId}/{filename}
    //   - Any authenticated user may read (thumbnails / full images).
    //   - Only MANAGER-role users (checked via Firestore) may write or delete.
    //     Setters upload evidence through a store method that runs under the
    //     manager's session context; raw Storage writes are still gated here.
    // ----------------------------------------------------------------
    match /evidence/{projectId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Manager';
    }

    // ----------------------------------------------------------------
    // Catch-all: any signed-in user may read/write all other paths
    // (profile photos, project images, etc.)
    // ----------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

  }
}
