rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function manager() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active != false
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Manager';
    }

    function canWriteProject(projectId) {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      return signedIn() && user.active != false
        && (!(('status' in project)) || project.status != 'Closed')
        && (!(('date_picked_up' in project)) || project.date_picked_up == null)
        && (user.role == 'Manager'
          || (project.activeAssignees is list
            && (request.auth.uid in project.activeAssignees
              || project.activeAssignees.hasAny(user.legacyProfileIds)))
          || (('assignedSetterId' in project)
            && (request.auth.uid == project.assignedSetterId
              || project.assignedSetterId in user.legacyProfileIds))
          || (('assignedJewellerId' in project)
            && (request.auth.uid == project.assignedJewellerId
              || project.assignedJewellerId in user.legacyProfileIds))
          || (('assignedDesignerId' in project)
            && (request.auth.uid == project.assignedDesignerId
              || project.assignedDesignerId in user.legacyProfileIds)));
    }

    function validEvidence(kind, uploaderUid, operationId) {
      return signedIn()
        && resource == null
        && request.auth.uid == uploaderUid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.uploaderUid == uploaderUid
        && request.resource.metadata.operationId == operationId
        && request.resource.metadata.evidenceKind == kind
        && request.resource.metadata.projectId is string;
    }

    match /evidence/issues/{uploaderUid}/{operationId}/{fileName} {
      allow read: if manager();
      allow create: if manager() && validEvidence('issues', uploaderUid, operationId);
      allow update, delete: if false;
    }

    match /evidence/returns/{uploaderUid}/{operationId}/{fileName} {
      allow read: if manager();
      allow create: if validEvidence('returns', uploaderUid, operationId);
      allow update, delete: if false;
    }

    // Historical evidence remains preserved and becomes Manager-only.
    match /evidence/{legacyPath=**} {
      allow read: if manager();
      allow write: if false;
    }

    match /profiles/{userId}/{path=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /projects/{projectId}/{path=**} {
      allow read: if signedIn();
      allow create, update: if canWriteProject(projectId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canWriteProject(projectId);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
