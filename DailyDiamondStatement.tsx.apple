import React, { useState, useMemo, useEffect } from 'react';
import { Search, ArrowDownLeft, ArrowUpRight, Calendar, Activity, Gem, TrendingUp, Clock, Info, CheckCircle2 } from 'lucide-react';
import { Card } from '../UI';
import { observer } from 'mobx-react-lite';
import { store } from '../../services/store';
import { InventoryMovementType, DiamondSpec } from '../../types';

export const DailyDiamondStatement = observer(() => {
  const [statementDate, setStatementDate] = useState(() => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  });
  const [searchQuery, setSearchQuery] = useState('');
  const [activeTab, setActiveTab] = useState<'melles' | 'bigStones'>('melles');
  const [filterMode, setFilterMode] = useState<'all' | 'shipment_in' | 'outgoing' | 'setted'>('all');
  const [lastUpdated, setLastUpdated] = useState<Date>(new Date());

  const diamondSpecs = store.getDiamondSpecs();
  const allMovements = store.getInventoryMovements();

  // Update "last updated" time whenever movements change
  useEffect(() => {
    setLastUpdated(new Date());
  }, [allMovements.length]);

  // Global Melles Inventory Values (Live)
  const { totalPcs, totalCt, totalValueUsd } = useMemo(() => {
    let pcs = 0, ct = 0, value = 0;
    diamondSpecs.forEach(spec => {
      // Assuming all specs that have defaultCostPerCtUsd and pcs/ct represent melles
      if ((spec.pcs || 0) > 0 || (spec.ct || 0) > 0) {
        pcs += (spec.pcs || 0);
        ct += (spec.ct || 0);
        value += ((spec.ct || 0) * (spec.defaultCostPerCtUsd || 0));
      }
    });
    return { totalPcs: pcs, totalCt: ct, totalValueUsd: value };
  }, [diamondSpecs, diamondSpecs.length]);

  // Selected Date Metrics
  const dateMetrics = useMemo(() => {
    let incomingCt = 0, incomingPcs = 0;
    let outgoingCt = 0, outgoingPcs = 0;
    let returnedCt = 0, returnedPcs = 0;

    const movementsForDate = allMovements.filter(mov => {
      const d = new Date(mov.createdAt);
      const movDate = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      return movDate === statementDate;
    });

    movementsForDate.forEach(mov => {
      mov.lines.forEach(line => {
        const spec = diamondSpecs.find(s => s.id === line.specId);
        const ctPerStone = spec?.ctPerStone || 0;
        const lineCt = line.ct || (line.pcs && ctPerStone ? line.pcs * ctPerStone : 0);
        const linePcs = line.pcs || (line.ct && ctPerStone ? Math.round(line.ct / ctPerStone) : 0);

        if (mov.type === InventoryMovementType.SHIPMENT_IN) {
          incomingCt += lineCt;
          incomingPcs += linePcs;
        } else if (mov.type === InventoryMovementType.ISSUE) {
          outgoingCt += lineCt;
          outgoingPcs += linePcs;
        } else if (mov.type === InventoryMovementType.RETURN || mov.type === InventoryMovementType.RETURN_MIXED || mov.type === InventoryMovementType.BULK_RETURN_INTAKE) {
          returnedCt += lineCt;
          returnedPcs += linePcs;
        }
      });
    });

    return {
      incomingCt,
      incomingPcs,
      outgoingCt,
      outgoingPcs,
      settedCt: Math.max(0, outgoingCt - returnedCt),
      settedPcs: Math.max(0, outgoingPcs - returnedPcs),
    };
  }, [allMovements, allMovements.length, statementDate, diamondSpecs, diamondSpecs.length]);

  // Filtered Table Data
  const tableData = useMemo(() => {
    const specsMap = new Map<string, {
      spec: DiamondSpec;
      inPcs: number; inCt: number;
      outPcs: number; outCt: number;
      retPcs: number; retCt: number;
    }>();

    const movementsForDate = allMovements.filter(mov => {
      const d = new Date(mov.createdAt);
      const movDate = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      return movDate === statementDate;
    });

    movementsForDate.forEach(mov => {
      mov.lines.forEach(line => {
        if (!line.specId) return;
        const spec = diamondSpecs.find(s => s.id === line.specId);
        if (!spec) return;

        if (!specsMap.has(spec.id)) {
          specsMap.set(spec.id, { spec, inPcs: 0, inCt: 0, outPcs: 0, outCt: 0, retPcs: 0, retCt: 0 });
        }
        
        const entry = specsMap.get(spec.id)!;
        const lineCt = line.ct || (line.pcs && spec.ctPerStone ? line.pcs * spec.ctPerStone : 0);
        const linePcs = line.pcs || (line.ct && spec.ctPerStone ? Math.round(line.ct / spec.ctPerStone) : 0);

        if (mov.type === InventoryMovementType.SHIPMENT_IN) {
          entry.inCt += lineCt;
          entry.inPcs += linePcs;
        } else if (mov.type === InventoryMovementType.ISSUE) {
          entry.outCt += lineCt;
          entry.outPcs += linePcs;
        } else if (mov.type === InventoryMovementType.RETURN || mov.type === InventoryMovementType.RETURN_MIXED || mov.type === InventoryMovementType.BULK_RETURN_INTAKE) {
          entry.retCt += lineCt;
          entry.retPcs += linePcs;
        }
      });
    });

    return Array.from(specsMap.values())
      .filter(row => {
        const settedCt = Math.max(0, row.outCt - row.retCt);
        const sizeStr = row.spec.sizeMm?.toString() || '';
        const matchesSearch = !searchQuery || sizeStr.includes(searchQuery) || row.spec.label.toLowerCase().includes(searchQuery.toLowerCase());
        
        if (!matchesSearch) return false;
        
        if (filterMode === 'shipment_in') return row.inCt > 0;
        if (filterMode === 'outgoing') return row.outCt > 0;
        if (filterMode === 'setted') return settedCt > 0;
        
        // 'all' shows rows with any activity
        return row.inCt > 0 || row.outCt > 0 || row.retCt > 0;
      })
      .map(row => {
        const settedCt = Math.max(0, row.outCt - row.retCt);
        const settedPcs = Math.max(0, row.outPcs - row.retPcs);
        return {
          ...row,
          settedCt,
          settedPcs
        };
      })
      .sort((a, b) => (a.spec.sizeMm || 0) - (b.spec.sizeMm || 0));
  }, [allMovements, allMovements.length, statementDate, diamondSpecs, diamondSpecs.length, searchQuery, filterMode]);


  const timeFormatted = lastUpdated.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  const dateFormatted = lastUpdated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

  return (
    <div className="space-y-6">
      {/* ── Tabs Header ── */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div className="flex bg-zinc-900/60 p-1.5 rounded-2xl border border-zinc-800/80 backdrop-blur-md w-fit">
          <button 
            className={`px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 ${activeTab === 'melles' ? 'bg-lux-gold text-lux-black shadow-glow' : 'text-zinc-400 hover:text-white'}`}
            onClick={() => setActiveTab('melles')}
          >
            <Gem size={16} /> Melles
          </button>
          <button 
            className={`px-6 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center gap-2 text-zinc-500 cursor-not-allowed`}
            disabled
          >
            <Gem size={16} className="opacity-50" /> All Big Stones <span className="text-[10px] bg-zinc-800/80 px-2 py-0.5 rounded-md ml-2 border border-zinc-700">Coming soon</span>
          </button>
        </div>

        <div className="flex items-center gap-3">
          <div className="flex items-center gap-2 bg-zinc-900/80 border border-zinc-800 px-4 py-3 rounded-2xl backdrop-blur-md">
            <Calendar size={16} className="text-lux-gold" />
            <input
              type="date"
              value={statementDate}
              onChange={(e) => setStatementDate(e.target.value)}
              className="bg-transparent text-white text-sm font-bold focus:outline-none cursor-pointer"
            />
          </div>
        </div>
      </div>

      {activeTab === 'melles' && (
        <>
          {/* ── Dashboard Grid (Glassmorphism Widgets) ── */}
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-5">
            
            {/* HERO WIDGET: Total Inventory Value */}
            <div className="lg:col-span-5 liquid-glass p-8 flex flex-col justify-between relative group overflow-hidden">
              <div className="absolute top-0 right-0 w-64 h-64 bg-lux-gold/10 rounded-full blur-3xl pointer-events-none group-hover:bg-lux-gold/20 transition-all duration-700" />
              <div>
                <div className="text-[11px] font-bold uppercase tracking-widest text-lux-gold/90 mb-3 flex items-center gap-2">
                  <Activity size={14} /> Statement Total Inventory Value
                </div>
                <div className="text-5xl font-black text-white tracking-tight drop-shadow-sm">
                  ${totalValueUsd.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </div>
                <div className="text-emerald-400 text-xs font-bold mt-3 flex items-center gap-1.5 bg-emerald-500/10 w-fit px-2.5 py-1 rounded-lg border border-emerald-500/20">
                  <TrendingUp size={12} /> Live Value
                </div>
              </div>
              <div className="mt-8 flex items-center justify-between border-t border-zinc-800/60 pt-4">
                <div className="text-xs text-zinc-400 flex items-center gap-1.5">
                  <Clock size={12} /> Last updated: {dateFormatted} at {timeFormatted}
                </div>
              </div>
            </div>

            {/* OVERVIEW WIDGET: Total Pieces & Weight */}
            <div className="lg:col-span-3 glass-card p-6 flex flex-col justify-between relative overflow-hidden group hover:border-zinc-700">
               <div className="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full blur-2xl pointer-events-none" />
               <div>
                  <div className="text-[11px] font-bold uppercase tracking-widest text-zinc-400 mb-6 flex items-center justify-between">
                    <span>Global Stock Overview</span>
                    <Info size={14} className="text-zinc-500" />
                  </div>
                  
                  <div className="mb-6">
                    <div className="text-sm font-semibold text-zinc-400 mb-1">Total Pieces in Stock</div>
                    <div className="text-3xl font-extrabold text-white">{totalPcs.toLocaleString()} <span className="text-sm font-medium text-zinc-500">pcs</span></div>
                  </div>

                  <div>
                    <div className="text-sm font-semibold text-zinc-400 mb-1">Total Weight</div>
                    <div className="text-3xl font-extrabold text-white">{totalCt.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 })} <span className="text-sm font-medium text-zinc-500">ct</span></div>
                  </div>
               </div>
               
               <div className="mt-6 pt-4 border-t border-zinc-800/40 text-[10px] text-zinc-500 font-mono">
                 LIVE SYNC • {timeFormatted}
               </div>
            </div>

            {/* MOVEMENT WIDGET: Split Card for Sent to Factory & Used */}
            <div className="lg:col-span-4 flex flex-col gap-5">
              
              <div className="glass-card p-5 relative overflow-hidden group hover:border-cyan-500/30 transition-all flex items-center justify-between bg-gradient-to-r from-zinc-900/50 to-cyan-950/20">
                 <div>
                    <div className="text-[11px] font-bold uppercase tracking-widest text-cyan-400 mb-2 flex items-center gap-1.5">
                      <ArrowDownLeft size={14} /> Incoming Today
                    </div>
                    <div className="text-2xl font-black text-white">{dateMetrics.incomingCt.toFixed(3)} <span className="text-sm font-medium text-cyan-400/60">ct</span></div>
                    <div className="text-xs text-zinc-400 mt-1">{dateMetrics.incomingPcs.toLocaleString()} pcs received</div>
                 </div>
                 <div className="h-12 w-12 rounded-full bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
                    <Gem size={20} />
                 </div>
              </div>

              <div className="glass-card flex-1 flex relative overflow-hidden group">
                 {/* Hover Overlay Animation */}
                 <div className="absolute inset-0 bg-gradient-to-r from-amber-500/5 via-orange-500/5 to-rose-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />
                 
                 <div className="w-1/2 p-5 border-r border-zinc-800/60 flex flex-col justify-center">
                    <div className="text-[11px] font-bold uppercase tracking-widest text-orange-400 mb-2 flex items-center gap-1.5">
                      <ArrowUpRight size={14} /> Sent to Factory
                    </div>
                    <div className="text-2xl font-black text-white">{dateMetrics.outgoingCt.toFixed(3)} <span className="text-sm font-medium text-zinc-500">ct</span></div>
                    <div className="text-xs text-zinc-400 mt-1">{dateMetrics.outgoingPcs.toLocaleString()} pcs issued</div>
                 </div>

                 <div className="w-1/2 p-5 flex flex-col justify-center bg-zinc-900/30 group-hover:bg-amber-950/20 transition-colors duration-500">
                    <div className="text-[11px] font-bold uppercase tracking-widest text-amber-400 mb-2 flex items-center gap-1.5">
                      <CheckCircle2 size={14} /> Used (Setted)
                    </div>
                    <div className="text-2xl font-black text-amber-400 group-hover:scale-105 transform origin-left transition-transform duration-500">{dateMetrics.settedCt.toFixed(3)} <span className="text-sm font-medium text-amber-400/50">ct</span></div>
                    <div className="text-xs text-amber-400/60 mt-1">{dateMetrics.settedPcs.toLocaleString()} pcs consumed</div>
                 </div>
              </div>

            </div>

          </div>

          {/* ── Filter Control Bar ── */}
          <div className="flex flex-col md:flex-row items-center justify-between gap-4 bg-zinc-900/40 p-3 rounded-2xl border border-zinc-800/80 backdrop-blur-sm">
            <div className="relative w-full md:w-80">
              <Search size={14} className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400" />
              <input
                type="text"
                placeholder="Search by size (e.g. 0.8)..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full bg-zinc-950 border border-zinc-800 text-white placeholder:text-zinc-600 text-sm rounded-xl pl-10 pr-4 py-2.5 focus:outline-none focus:border-lux-gold transition-colors shadow-inner"
              />
            </div>

            <div className="flex items-center bg-zinc-950 p-1 rounded-xl border border-zinc-800 w-full md:w-auto overflow-x-auto">
              <button
                onClick={() => setFilterMode('all')}
                className={`px-4 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap ${
                  filterMode === 'all' ? 'bg-zinc-800 text-white shadow-sm' : 'text-zinc-400 hover:text-white'
                }`}
              >
                All Activity
              </button>
              <button
                onClick={() => setFilterMode('shipment_in')}
                className={`px-4 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap ${
                  filterMode === 'shipment_in' ? 'bg-cyan-500/20 text-cyan-400 border border-cyan-500/30' : 'text-zinc-400 hover:text-white'
                }`}
              >
                Shipment In
              </button>
              <button
                onClick={() => setFilterMode('outgoing')}
                className={`px-4 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap ${
                  filterMode === 'outgoing' ? 'bg-orange-500/20 text-orange-400 border border-orange-500/30' : 'text-zinc-400 hover:text-white'
                }`}
              >
                Outgoing (Factory)
              </button>
              <button
                onClick={() => setFilterMode('setted')}
                className={`px-4 py-2 rounded-lg text-xs font-bold transition-all whitespace-nowrap ${
                  filterMode === 'setted' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' : 'text-zinc-400 hover:text-white'
                }`}
              >
                Setted (Used)
              </button>
            </div>
          </div>

          {/* ── Main Data Table ── */}
          <Card className="overflow-hidden border-zinc-800/80 bg-zinc-950/90 shadow-2xl backdrop-blur-xl">
            <div className="overflow-x-auto">
              <table className="w-full text-left text-sm">
                <thead>
                  <tr className="bg-zinc-900/90 text-zinc-400 font-bold uppercase tracking-wider text-[10px] border-b border-zinc-800/80">
                    <th className="py-4 px-5">Diamond Specs</th>
                    <th className="py-4 px-5 text-right text-cyan-400/80">Shipment In</th>
                    <th className="py-4 px-5 text-right text-orange-400/80">Outgoing</th>
                    <th className="py-4 px-5 text-right text-amber-400/80">Setted (Used)</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-zinc-800/40">
                  {tableData.length > 0 ? (
                    tableData.map((row) => (
                      <tr key={row.spec.id} className="hover:bg-zinc-900/40 transition-colors group">
                        <td className="py-3.5 px-5">
                          <div className="font-bold text-white flex items-center gap-2">
                            {row.spec.label}
                            {row.spec.color && <span className="text-[10px] bg-zinc-800 text-zinc-300 px-1.5 py-0.5 rounded">{row.spec.color}</span>}
                          </div>
                          <div className="text-xs text-zinc-500 mt-0.5">${row.spec.defaultCostPerCtUsd?.toLocaleString()}/ct • {row.spec.ctPerStone} ct/pc</div>
                        </td>
                        <td className="py-3.5 px-5 text-right">
                          {row.inCt > 0 ? (
                            <div>
                              <span className="font-bold text-cyan-400">{row.inCt.toFixed(3)} ct</span>
                              <div className="text-xs text-zinc-500 mt-0.5">{row.inPcs} pcs</div>
                            </div>
                          ) : <span className="text-zinc-700">-</span>}
                        </td>
                        <td className="py-3.5 px-5 text-right">
                          {row.outCt > 0 ? (
                            <div>
                              <span className="font-bold text-orange-400">{row.outCt.toFixed(3)} ct</span>
                              <div className="text-xs text-zinc-500 mt-0.5">{row.outPcs} pcs</div>
                            </div>
                          ) : <span className="text-zinc-700">-</span>}
                        </td>
                        <td className="py-3.5 px-5 text-right">
                          {row.settedCt > 0 ? (
                            <div className="bg-amber-500/10 border border-amber-500/20 px-3 py-1.5 rounded-lg inline-block text-right min-w-[90px]">
                              <div className="font-bold text-amber-400">{row.settedCt.toFixed(3)} ct</div>
                              <div className="text-[10px] text-amber-400/60 mt-0.5">{row.settedPcs} pcs</div>
                            </div>
                          ) : <span className="text-zinc-700">-</span>}
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colSpan={4} className="py-12 text-center text-zinc-500 text-sm">
                        No movement data found for {dateFormatted} with the current filters.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </Card>
        </>
      )}
    </div>
  );
});